#!/usr/bin/env bash

# ==============================================================================
#
# FILE:         fc-dns
#
# DESCRIPTION:  Manage the system's DNS settings from the command line.
#               Allows viewing, setting, and clearing custom DNS servers for
#               the active network interface.
#
# CROSS-PLATFORM:
#   - macOS: Uses networksetup (built-in)
#   - Linux: Uses resolvectl (systemd-resolved) or /etc/resolv.conf
#
# REQUIRES:
#   - macOS 10.6+ or Linux
#   - Active network connection
#   - Administrator privileges for set/clear operations
#
# ACTIONS:
#   get/status  - Show current DNS servers
#   set <ip>... - Set one or more custom DNS servers
#   clear       - Clear custom DNS, revert to DHCP-provided servers
#
# EXAMPLES:
#   fc dns get                       # Show current DNS servers
#   fc dns set 8.8.8.8 8.8.4.4       # Use Google DNS
#   fc dns set 1.1.1.1               # Use Cloudflare DNS
#   fc dns clear                     # Revert to DHCP DNS
#
# POPULAR DNS PROVIDERS:
#   Google:     8.8.8.8, 8.8.4.4
#   Cloudflare: 1.1.1.1, 1.0.0.1
#   OpenDNS:    208.67.222.222, 208.67.220.220
#   Quad9:      9.9.9.9, 149.112.112.112
#
# ==============================================================================

# --- Initialization ---------------------------------------------------------
source "$(dirname "${BASH_SOURCE[0]}")/../init.sh"

# --- Help and Usage ---------------------------------------------------------
usage() {
  msg_info "Usage: fc dns <action> [dns_servers...]"
  echo ""
  msg_info "Manages the DNS settings for the active network service."
  msg_info "This command requires administrator privileges to change settings."
  echo ""
  msg_info "Actions:"
  echo "  get             - Show the current DNS servers."
  echo "  set <ip>...     - Set one or more custom DNS servers."
  echo "  clear           - Clear custom DNS servers, reverting to default."
  echo ""
  msg_info "Auditing (S30):"
  echo "  baseline        - Record current resolvers as the expected set"
  echo "  leak-check      - Warn if resolvers differ from the expected set"
  echo "  test [domain]   - Resolve a domain (default: github.com)"
  echo "  status          - Alias for 'get'."
  echo ""
  msg_info "Examples:"
  echo "  fc dns get                     # View current DNS"
  echo "  fc dns set 8.8.8.8 8.8.4.4     # Use Google DNS"
  echo "  fc dns set 1.1.1.1 1.0.0.1     # Use Cloudflare DNS"
  echo "  fc dns clear                   # Use DHCP-provided DNS"
  echo ""
  msg_info "Popular DNS Providers:"
  echo "  Google:     8.8.8.8, 8.8.4.4"
  echo "  Cloudflare: 1.1.1.1, 1.0.0.1"
  echo "  OpenDNS:    208.67.222.222, 208.67.220.220"
  echo "  Quad9:      9.9.9.9, 149.112.112.112"
  echo ""
  if is_linux; then
    msg_info "Linux: Uses resolvectl or /etc/resolv.conf"
  fi
  exit 0
}

# --- Helper Functions -------------------------------------------------------

# Get the name of the active network service (macOS only)
#
# The device behind the default route is NOT always a hardware port. With any
# VPN or tunnel up it is a utun* interface, which appears in no hardware-port
# listing. The previous version piped that lookup straight through grep, and
# helpers.sh runs with `pipefail`, so the non-matching grep failed the whole
# pipeline, tripped the ERR trap, and every `fc dns` action — get, set and
# clear alike — aborted with "An unexpected error occurred on line 89" for
# anyone connected to a VPN.
#
# So: try the mapping, and fall back rather than fail.
get_active_network_service() {
  if ! is_macos; then
    # Linux: not used.
    echo ""
    return 0
  fi

  local active_device=""
  active_device=$(route -n get default 2>/dev/null | awk '/interface:/ {print $2}') || true

  local service=""
  if [[ -n "$active_device" ]]; then
    # `|| true` on each stage: "no match" is an expected outcome here, not an
    # error, and must not propagate under pipefail.
    service=$(networksetup -listallhardwareports 2>/dev/null \
      | grep -B1 "Device: $active_device" \
      | grep "Hardware Port:" \
      | sed 's/Hardware Port: //' || true)
  fi

  # Tunnel interface, or no default route at all: fall back to the first
  # configured service that currently holds an IP address, which is the one
  # whose DNS settings the user actually means.
  if [[ -z "$service" ]]; then
    local candidate
    while IFS= read -r candidate; do
      # Skip the listing's header line and disabled-service markers.
      case "$candidate" in
        ''|An\ asterisk*|\**) continue ;;
      esac
      if networksetup -getinfo "$candidate" 2>/dev/null | grep -qE '^IP address: [0-9]'; then
        service="$candidate"
        break
      fi
    done < <(networksetup -listallnetworkservices 2>/dev/null || true)
  fi

  # Last resort, preserving the original intent.
  if [[ -z "$service" ]]; then
    service="Wi-Fi"
  fi

  echo "$service"
}

# --- Main Logic -------------------------------------------------------------
main() {
  if [ -z "$1" ] || [ "$1" == "--help" ]; then
    usage
  fi

  # --- Find Active Network Service (macOS) ----------------------------------
  local service=""
  if is_macos; then
    service=$(get_active_network_service)
    if [ -z "$service" ]; then
      die "No active network service found."
    fi
    msg_info "Active network service: $service"
  fi

  ACTION="$1"
  shift

  case "$ACTION" in

    # --- Action: get/status -------------------------------------------------
    get|status)
      msg_info "Current DNS servers:"
      os_get_dns "$service"
      ;;

    # --- Action: set --------------------------------------------------------
    set)
      if [ -z "$1" ]; then
        die "You must provide at least one DNS server IP address."
      fi
      msg_info "Setting DNS servers to: $*"
      os_set_dns "$service" "$@"
      msg_success "DNS servers have been updated."
      ;;

    # --- Action: clear ------------------------------------------------------
    clear)
      msg_info "Clearing DNS servers..."
      os_clear_dns "$service"
      msg_success "DNS servers have been cleared. System will use DHCP-provided servers."
      ;;

    # --- Auditing (S30) -----------------------------------------------------
    #
    # These delegate to lib/security.sh. The functions were written, exported
    # and never called from anywhere, so the leak check had no way to be run.
    #
    # `|| exit $?` because helpers.sh installs a `trap ... ERR` that converts
    # any non-zero return into error_handler's exit 1; a bare call would report
    # "an unexpected error occurred" for a detected leak, and lose the status a
    # scheduled job needs.
    leak-check)
      dns_leak_check || exit $?
      ;;

    baseline)
      save_expected_dns || exit $?
      msg_info "Check for drift later with: fc dns leak-check"
      ;;

    test)
      dns_resolution_test "${1:-}" || exit $?
      ;;

    *)
      die "Unknown action '$ACTION'. Run 'fc dns --help' for available actions."
      ;;
  esac
}

main "$@"
