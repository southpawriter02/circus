#!/usr/bin/env bash

# ==============================================================================
#
# FILE:         fc-audit
#
# DESCRIPTION:  Run a security audit to check system protection settings.
#               Verifies critical macOS security features are enabled and
#               provides a security posture score.
#
# USAGE:        fc audit <action>
#
# ACTIONS:
#   run         Run full security audit (8 checks)
#               - System Protection: SIP, FileVault, Gatekeeper, Firewall
#               - Authentication: Password after sleep, Auto login
#               - Network: Stealth mode, Remote login (SSH)
#               - Provides pass/fail score
#
#   quick       Quick check of 4 critical settings
#               - SIP, FileVault, Gatekeeper, Firewall only
#               - Fast way to verify essential protections
#
#   sip         Check System Integrity Protection details
#               - Shows what SIP protects
#               - Instructions for modification (requires Recovery Mode)
#
#   filevault   Check FileVault disk encryption status
#               - Shows encryption state and enabled users
#               - Link to enable if disabled
#
#   gatekeeper  Check Gatekeeper status
#               - Explains what Gatekeeper protects against
#               - Command to re-enable if disabled
#
#   firewall    Check Application Firewall details
#               - Global state, stealth mode, block all mode
#               - Link to System Settings for management
#
# EXAMPLES:
#   fc audit run            # Full audit with scoring
#   fc audit quick          # Fast 4-check summary
#   fc audit sip            # SIP details
#   fc audit filevault      # Encryption status
#
# SECURITY CHECKS EXPLAINED:
#
#   SIP (System Integrity Protection):
#     Protects system files from modification, even by root.
#     Should always be enabled unless developing kexts.
#
#   FileVault:
#     Full-disk encryption protecting data if Mac is stolen.
#     Strongly recommended for all portable Macs.
#
#   Gatekeeper:
#     Blocks unsigned and unnotarized apps from running.
#     Prevents most malware installations.
#
#   Application Firewall:
#     Controls incoming network connections per-app.
#     Stealth mode hides Mac from network scans.
#
#   Password After Sleep:
#     Requires password to unlock after sleep/screensaver.
#     Essential for physical security.
#
#   Automatic Login:
#     Should be disabled; bypasses login authentication.
#
#   Remote Login (SSH):
#     Allows remote terminal access. Enable only if needed.
#
# RECOMMENDATIONS:
#   - Run 'fc audit run' periodically (monthly)
#   - All items should show ✓ for maximum security
#   - FileVault and Password After Sleep are critical for laptops
#   - Disable Remote Login unless actively using SSH
#
# DEPENDENCIES:
#   Required: csrutil, fdesetup, spctl, systemsetup (built-in to macOS)
#   Required: defaults, socketfilterfw (built-in to macOS)
#
# ==============================================================================

# --- Initialization ---------------------------------------------------------
# Source the common initialization script for logging and error handling
source "$(dirname "${BASH_SOURCE[0]}")/../init.sh"

# --- Help and Usage ---------------------------------------------------------
usage() {
  msg_info "Usage: fc audit <action>"
  echo ""
  msg_info "Run security audits to check system protection settings."
  echo ""
  msg_info "Actions:"
  echo "  run             - Run full security audit"
  echo "  quick           - Quick check of critical settings"
  echo "  sip             - Check System Integrity Protection"
  echo "  filevault       - Check FileVault encryption status"
  echo "  gatekeeper      - Check Gatekeeper status"
  echo "  firewall        - Check firewall status"
  echo ""
  msg_info "Security Event Log (S21):"
  echo "  events [n]      - Show the last n security events (default 50)"
  echo "  events-by <sev> - Filter events by severity"
  echo "                    (info, warning, error, critical)"
  echo "  event-stats     - Summarise recorded security events"
  echo ""
  msg_info "Failed Operations (S23):"
  echo "  failures [n]    - Show the last n failed operations (default 20)"
  echo "  clear-failures  - Clear the failed operations log"
  echo ""
  msg_info "Network Requests (S28):"
  echo "  network [n]     - Show the last n logged network requests (default 30)"
  echo "  network-stats   - Summarise logged network requests"
  echo ""
  msg_info "Files and Packages:"
  echo "  permissions [d] - Scan a directory for insecure config permissions"
  echo "                    (S13, default: the repository's configs/)"
  echo "  integrity       - Verify tracked scripts against the hash"
  echo "                    manifest (S17)"
  echo "  manifest        - Show the recorded script hash manifest (S17)"
  echo "  manifest-create - Record current script hashes as trusted (S17)"
  echo "  taps            - List Homebrew taps and flag untrusted ones (S18)"
  echo "  domains         - Show the download allowlist (S26)"
  echo "  health-report   - Full security health report in Markdown (S25)"
  echo ""
  msg_info "Examples:"
  echo "  fc audit run              # Full audit with score"
  echo "  fc audit quick            # Fast 4-check summary"
  echo "  fc audit events 100       # Last 100 security events"
  echo "  fc audit events-by critical"
  echo ""
  exit 0
}


# --- Check Functions --------------------------------------------------------

# Check SIP status, returns 0 if enabled
check_sip() {
  local status
  status=$(csrutil status 2>/dev/null)
  if echo "$status" | grep -q "enabled"; then
    echo "enabled"
    return 0
  else
    echo "disabled"
    return 1
  fi
}

# Check FileVault status
check_filevault() {
  local status
  status=$(fdesetup status 2>/dev/null)
  if echo "$status" | grep -qi "FileVault is On"; then
    echo "enabled"
    return 0
  elif echo "$status" | grep -qi "in progress"; then
    echo "encrypting"
    return 0
  else
    echo "disabled"
    return 1
  fi
}

# Check Gatekeeper status
check_gatekeeper() {
  local status
  status=$(spctl --status 2>/dev/null)
  if echo "$status" | grep -q "assessments enabled"; then
    echo "enabled"
    return 0
  else
    echo "disabled"
    return 1
  fi
}

# Check firewall status
check_firewall() {
  local status
  status=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)

  # Match on the state NUMBER, not the word "enabled". socketfilterfw reports
  # three states and only one of them contains that word:
  #
  #   State = 0  "Firewall is disabled. (State = 0)"
  #   State = 1  "Firewall is enabled. (State = 1)"
  #   State = 2  "Firewall is blocking all non-essential incoming connections."
  #
  # State 2 is the STRICTEST setting, and the old `grep -qi enabled` reported it
  # as disabled — so a machine locked down to block-all was told its firewall
  # was off, and (because this returns non-zero) the audit then aborted.
  case "$status" in
    *"State = 1"*|*"State = 2"*)
      echo "enabled"
      return 0
      ;;
  esac

  echo "disabled"
  return 1
}

# Check stealth mode
check_stealth() {
  local status
  status=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode 2>/dev/null)

  # Same defect as check_firewall: socketfilterfw reports stealth mode as
  # "Firewall stealth mode is on" / "... is off". Neither string contains
  # "enabled", so `grep -qi enabled` reported stealth as disabled even when it
  # was on.
  case "$status" in
    *" on"*|*"State = 1"*)
      echo "enabled"
      return 0
      ;;
  esac

  echo "disabled"
  return 1
}

# Check auto login
check_auto_login() {
  local status
  status=$(defaults read /Library/Preferences/com.apple.loginwindow autoLoginUser 2>/dev/null)
  if [[ -n "$status" ]]; then
    echo "enabled"
    return 1  # Auto login enabled is BAD
  else
    echo "disabled"
    return 0
  fi
}

# Check remote login (SSH)
check_remote_login() {
  local status
  status=$(systemsetup -getremotelogin 2>/dev/null)
  if echo "$status" | grep -qi "on"; then
    echo "enabled"
    return 1  # Enabled means potential risk
  else
    echo "disabled"
    return 0
  fi
}

# Check password after sleep
check_password_sleep() {
  local status
  status=$(defaults read com.apple.screensaver askForPassword 2>/dev/null)
  if [[ "$status" == "1" ]]; then
    echo "required"
    return 0
  else
    echo "not required"
    return 1
  fi
}

# --- Action Functions -------------------------------------------------------

# Print check result
print_check() {
  local name="$1"
  local status="$2"
  local good="$3"  # expected good state
  
  local icon
  local padding="%-40s"
  
  if [[ "$status" == "$good" ]] || [[ "$status" == "enabled" && "$good" == "on" ]]; then
    icon="✓"
    printf "  $icon $padding %s\n" "$name" "$status"
  else
    icon="⚠"
    printf "  $icon $padding %s\n" "$name" "$status"
  fi
}

# Full security audit
action_run() {
  msg_info "🔒 macOS Security Audit"
  echo ""
  
  local passed=0
  local total=0
  
  # System Protection
  echo "System Protection:"
  
  total=$((total + 1))
  local sip_status
  # `|| true` on every check_* capture below.
  #
  # These helpers report a BAD finding by returning non-zero, and helpers.sh
  # runs with `set -e` plus an ERR trap. So a failing assignment aborted the
  # whole audit with "an unexpected error occurred" — meaning `fc audit run`
  # and `fc audit quick` crashed precisely when they had something to warn
  # about, and only completed on a machine where every single check passed.
  sip_status=$(check_sip) || true
  if [[ "$sip_status" == "enabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ System Integrity Protection (SIP)     Enabled"
  else
    echo "  ⚠ System Integrity Protection (SIP)     Disabled"
  fi
  
  total=$((total + 1))
  local fv_status
  fv_status=$(check_filevault) || true
  if [[ "$fv_status" == "enabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ FileVault Disk Encryption             Enabled"
  elif [[ "$fv_status" == "encrypting" ]]; then
    passed=$((passed + 1))
    echo "  ⚠ FileVault Disk Encryption             In Progress"
  else
    echo "  ⚠ FileVault Disk Encryption             Disabled"
  fi
  
  total=$((total + 1))
  local gk_status
  gk_status=$(check_gatekeeper) || true
  if [[ "$gk_status" == "enabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Gatekeeper                            Enabled"
  else
    echo "  ⚠ Gatekeeper                            Disabled"
  fi
  
  total=$((total + 1))
  local fw_status
  fw_status=$(check_firewall) || true
  if [[ "$fw_status" == "enabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Application Firewall                  Enabled"
  else
    echo "  ⚠ Application Firewall                  Disabled"
  fi
  
  echo ""
  echo "Authentication:"
  
  total=$((total + 1))
  local pw_status
  pw_status=$(check_password_sleep) || true
  if [[ "$pw_status" == "required" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Password Required After Sleep         Yes"
  else
    echo "  ⚠ Password Required After Sleep         No"
  fi
  
  total=$((total + 1))
  local auto_status
  auto_status=$(check_auto_login) || true
  if [[ "$auto_status" == "disabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Automatic Login                       Disabled"
  else
    echo "  ⚠ Automatic Login                       Enabled (risky)"
  fi
  
  echo ""
  echo "Network:"
  
  total=$((total + 1))
  local stealth_status
  stealth_status=$(check_stealth) || true
  if [[ "$stealth_status" == "enabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Firewall Stealth Mode                 Enabled"
  else
    echo "  ⚠ Firewall Stealth Mode                 Disabled"
  fi
  
  total=$((total + 1))
  local ssh_status
  ssh_status=$(check_remote_login) || true
  if [[ "$ssh_status" == "disabled" ]]; then
    passed=$((passed + 1))
    echo "  ✓ Remote Login (SSH)                    Disabled"
  else
    echo "  ⚠ Remote Login (SSH)                    Enabled"
  fi
  
  echo ""
  echo "──────────────────────────────────────────"
  
  local failed=$((total - passed))
  
  if [[ $passed -eq $total ]]; then
    msg_success "Score: $passed/$total checks passed - Excellent!"
  elif [[ $failed -le 2 ]]; then
    msg_info "Score: $passed/$total checks passed"
    msg_warning "$failed item(s) need attention"
  else
    msg_warning "Score: $passed/$total checks passed"
    msg_warning "$failed items need attention"
  fi
}

# Quick check
action_quick() {
  msg_info "Quick Security Check"
  echo ""
  
  local all_good=true
  
  local sip_status
  sip_status=$(check_sip) || true
  if [[ "$sip_status" == "enabled" ]]; then
    echo "  SIP:        ✓ Enabled"
  else
    echo "  SIP:        ✗ Disabled"
    all_good=false
  fi
  
  local fv_status
  fv_status=$(check_filevault) || true
  if [[ "$fv_status" == "enabled" ]] || [[ "$fv_status" == "encrypting" ]]; then
    echo "  FileVault:  ✓ Enabled"
  else
    echo "  FileVault:  ✗ Disabled"
    all_good=false
  fi
  
  local gk_status
  gk_status=$(check_gatekeeper) || true
  if [[ "$gk_status" == "enabled" ]]; then
    echo "  Gatekeeper: ✓ Enabled"
  else
    echo "  Gatekeeper: ✗ Disabled"
    all_good=false
  fi
  
  local fw_status
  fw_status=$(check_firewall) || true
  if [[ "$fw_status" == "enabled" ]]; then
    echo "  Firewall:   ✓ Enabled"
  else
    echo "  Firewall:   ✗ Disabled"
    all_good=false
  fi
  
  echo ""
  
  if $all_good; then
    msg_success "All critical protections active ✓"
  else
    msg_warning "Some critical protections are disabled!"
  fi
}

# Check SIP details
action_sip() {
  local status
  status=$(csrutil status 2>/dev/null)
  
  if echo "$status" | grep -q "enabled"; then
    msg_success "System Integrity Protection: Enabled ✓"
  else
    msg_warning "System Integrity Protection: Disabled ✗"
  fi
  
  echo ""
  echo "SIP protects:"
  echo "  • /System"
  echo "  • /usr (except /usr/local)"
  echo "  • /bin, /sbin"
  echo "  • Preinstalled apps"
  echo "  • Kernel extensions"
  echo ""
  msg_info "To modify SIP, boot into Recovery Mode (Cmd+R at startup)."
}

# Check FileVault details
action_filevault() {
  local status
  status=$(fdesetup status 2>/dev/null)
  
  if echo "$status" | grep -qi "FileVault is On"; then
    msg_success "FileVault Status: Enabled ✓"
    echo ""
    echo "  Encryption:   Fully Encrypted"
    
    # List enabled users
    local users
    users=$(fdesetup list 2>/dev/null | wc -l | tr -d ' ')
    echo "  Users:        $users enabled user(s)"
    
  elif echo "$status" | grep -qi "in progress"; then
    msg_warning "FileVault Status: Encryption In Progress"
    echo ""
    echo "$status"
  else
    msg_warning "FileVault Status: Disabled ✗"
    echo ""
    msg_info "Enable FileVault in System Settings > Privacy & Security > FileVault"
  fi
}

# Check Gatekeeper details
action_gatekeeper() {
  local status
  status=$(spctl --status 2>/dev/null)
  
  if echo "$status" | grep -q "assessments enabled"; then
    msg_success "Gatekeeper: Enabled ✓"
    echo ""
    echo "Gatekeeper blocks:"
    echo "  • Unsigned applications"
    echo "  • Apps not from identified developers"
    echo "  • Malware-infected software"
  else
    msg_warning "Gatekeeper: Disabled ✗"
    echo ""
    msg_info "Enable with: sudo spctl --master-enable"
  fi
}

# Check firewall details
action_firewall() {
  local global_status
  global_status=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null)
  
  if echo "$global_status" | grep -qi "enabled"; then
    msg_success "Application Firewall: Enabled ✓"
  else
    msg_warning "Application Firewall: Disabled ✗"
  fi
  
  echo ""
  
  local stealth_status
  stealth_status=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getstealthmode 2>/dev/null)
  
  if echo "$stealth_status" | grep -qi "enabled"; then
    echo "  Stealth Mode:     Enabled ✓"
  else
    echo "  Stealth Mode:     Disabled"
  fi
  
  local block_status
  block_status=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getblockall 2>/dev/null)
  
  if echo "$block_status" | grep -qi "enabled"; then
    echo "  Block All:        Enabled"
  else
    echo "  Block All:        Disabled"
  fi
  
  echo ""
  msg_info "Manage in System Settings > Network > Firewall"
}

# --- Main Logic -------------------------------------------------------------
main() {
  if [[ -z "$1" ]] || [[ "$1" == "--help" ]]; then
    usage
  fi

  local action="$1"
  shift

  case "$action" in
    run)
      action_run
      ;;
    quick)
      action_quick
      ;;
    sip)
      action_sip
      ;;
    filevault)
      action_filevault
      ;;
    gatekeeper)
      action_gatekeeper
      ;;
    firewall)
      action_firewall
      ;;

    # --- Log viewers (S21, S23, S28) ----------------------------------------
    #
    # These delegate to lib/security.sh. Every one of them was defined and
    # exported there with no caller anywhere in the repository: the logs were
    # being written by security_event/log_failed_operation, and nothing could
    # read them back. A security log nobody can read is not an audit trail.
    #
    # `|| exit $?` throughout, because helpers.sh installs a `trap ... ERR`
    # that rewrites any non-zero return as "an unexpected error occurred".

    events)
      security_audit_view "${1:-50}" || exit $?
      ;;

    events-by)
      if [[ -z "${1:-}" ]]; then
        die "Please specify a severity: info, warning, error or critical.\n\nExample: fc audit events-by critical"
      fi
      # Distinguish "no matching events" from a genuine failure: grep exits 1
      # when it matches nothing, which is an ordinary result here.
      local matches
      matches=$(security_events_by_severity "$1" || true)
      if [[ -z "$matches" ]]; then
        msg_info "No '$1' events recorded."
      else
        printf '%s\n' "$matches"
      fi
      ;;

    event-stats)
      security_event_stats || exit $?
      ;;

    failures)
      view_failed_operations "${1:-20}" || exit $?
      ;;

    clear-failures)
      clear_failed_operations || exit $?
      ;;

    network)
      view_network_requests "${1:-30}" || exit $?
      ;;

    network-stats)
      network_request_stats || exit $?
      ;;

    # --- Files and packages (S13, S17, S18, S25) ----------------------------

    permissions)
      # scan_config_permissions takes a MANDATORY directory; it has no default
      # and reports "Directory not found: " with an empty path when called
      # without one. Supply the repository's configs/ unless told otherwise.
      local perm_dir="${1:-$DOTFILES_ROOT/configs}"
      # Returns non-zero to report findings, which is a result, not a crash.
      scan_config_permissions "$perm_dir" || exit $?
      ;;

    integrity)
      # 0 = all match, 1 = a script changed, 2 = no manifest recorded yet.
      local rc=0
      verify_script_integrity || rc=$?
      if [[ "$rc" -eq 2 ]]; then
        echo ""
        msg_info "No manifest recorded yet. Create one with: fc audit manifest-create"
        echo ""
      fi
      exit "$rc"
      ;;

    manifest)
      show_hash_manifest || exit $?
      ;;

    manifest-create)
      # Records the current hashes as the trusted set. Without this action the
      # manifest could not be created at all: generate_hash_manifest had no
      # caller anywhere, so `integrity` had nothing to compare against and the
      # whole of S17 was unreachable.
      generate_hash_manifest "${1:-$DOTFILES_ROOT}" || exit $?
      ;;

    taps)
      list_brew_taps || exit $?
      if [[ -f "$DOTFILES_ROOT/Brewfile" ]]; then
        echo ""
        scan_brewfile_taps "$DOTFILES_ROOT/Brewfile" || exit $?
      fi
      ;;

    domains)
      # S26. Shows the effective download allowlist, including anything added
      # via CIRCUS_ALLOWED_DOMAINS.
      #
      # add_allowed_domain is deliberately NOT exposed: it only mutates an
      # in-process variable, so a change made from the command line would be
      # gone the moment the command exited. CIRCUS_ALLOWED_DOMAINS is the
      # mechanism that actually persists.
      list_allowed_domains || exit $?
      ;;

    health-report)
      # Optional output path; prints to stdout when omitted.
      security_health_report "${1:-}" || exit $?
      ;;

    *)
      die "Unknown action '$action'. Run 'fc audit --help' for available actions."
      ;;
  esac
}

main "$@"
