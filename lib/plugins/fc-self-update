#!/usr/bin/env bash

# ==============================================================================
#
# FILE:         fc-self-update
#
# DESCRIPTION:  Self-update mechanism for the Dotfiles Flying Circus.
#               Safely updates the framework with stash, migration, and
#               dependency handling.
#
# ==============================================================================

# --- Initialization ---------------------------------------------------------
source "$(dirname "${BASH_SOURCE[0]}")/../init.sh"

# --- Configuration ----------------------------------------------------------
readonly MIGRATIONS_DIR="$DOTFILES_ROOT/migrations"

# --- Help and Usage ---------------------------------------------------------
usage() {
  msg_info "Usage: fc self-update [options]"
  echo ""
  msg_info "Update the Dotfiles Flying Circus framework."
  echo ""
  msg_info "Options:"
  echo "  --check       Check if an update is available"
  echo "  --force       Force update even with uncommitted changes"
  echo "  --no-deps     Skip dependency installation"
  echo "  --dry-run     Show what would be done without making changes"
  echo ""
  msg_info "Examples:"
  echo "  fc self-update           # Perform full update"
  echo "  fc self-update --check   # Check for updates"
  echo "  fc self-update --force   # Update with local changes"
  echo ""
  exit 0
}

# --- Helper Functions -------------------------------------------------------

# get_current_version() is NOT defined here.
#
# It used to be, reading a "$DOTFILES_ROOT/VERSION" file that does not exist in
# this repository — the version file is `.version`. Because this plugin sources
# init.sh (and therefore helpers.sh) before defining its own functions, that
# local definition shadowed the correct helpers.sh:get_current_version() and
# every caller silently fell through to `git describe`, yielding
# "v1.6.0-23-ga56d307" where "1.6.0" was meant.
#
# That broke run_migrations: version_in_range() feeds these strings to
# version_compare(), which splits on '.' and compares parts numerically, so a
# describe string made migration selection meaningless. It also made
# `fc self-update --check` disagree with `fc info` about the current version.
#
# helpers.sh:get_current_version() reads .version and falls back to "0.0.0".

# Read the version the remote is offering, in the same format as the local one,
# so the two are comparable both on screen and in version_in_range().
get_remote_version() {
  git -C "$DOTFILES_ROOT" fetch --tags --quiet 2>/dev/null || true

  # Prefer the tracked .version file, mirroring get_current_version(). Assigned
  # separately: `$(git show ... | tr)` exits with tr's status, which is 0 even
  # when the git side failed, so the emptiness check is what detects failure.
  local remote_version
  remote_version=$(git -C "$DOTFILES_ROOT" show origin/main:.version 2>/dev/null | tr -d '[:space:]')
  if [[ -n "$remote_version" ]]; then
    echo "$remote_version"
    return 0
  fi

  git -C "$DOTFILES_ROOT" describe --tags origin/main 2>/dev/null || \
    git -C "$DOTFILES_ROOT" rev-parse --short origin/main 2>/dev/null || echo "unknown"
}

has_uncommitted_changes() {
  [[ -n "$(git -C "$DOTFILES_ROOT" status --porcelain 2>/dev/null)" ]]
}

get_commits_behind() {
  git -C "$DOTFILES_ROOT" rev-list HEAD..origin/main --count 2>/dev/null || echo "0"
}

#
# @description
#   Restore a stash created by this run, on every path that leaves do_update.
#
#   The previous restore was guarded by `has_uncommitted_changes`, which is
#   false immediately after a successful `stash push` — that is the whole point
#   of stashing. So the pop never ran and the user's work was left sitting in
#   the stash with only a success message on screen. The early returns
#   (already-up-to-date, cancelled at the prompt, refused signature, failed
#   fast-forward) did not attempt a restore at all.
#
# @param $1 "true" if this run created a stash
#
restore_stash_if_any() {
  [[ "$1" == "true" ]] || return 0

  echo ""
  msg_info "Restoring stashed changes..."
  if ! git -C "$DOTFILES_ROOT" stash pop --quiet 2>/dev/null; then
    msg_warning "Could not auto-restore your stashed changes."
    msg_info "They are safe — recover them with: git -C $DOTFILES_ROOT stash pop"
  fi
}

# --- Actions ----------------------------------------------------------------

do_check() {
  msg_info "Checking for updates..."
  echo ""
  
  # Fetch latest
  git -C "$DOTFILES_ROOT" fetch --quiet 2>/dev/null
  
  local current_version
  current_version=$(get_current_version)
  local remote_version
  remote_version=$(get_remote_version)
  local commits_behind
  commits_behind=$(get_commits_behind)
  
  echo "  Current version: $current_version"
  echo "  Remote version:  $remote_version"
  echo "  Commits behind:  $commits_behind"
  echo ""
  
  if [[ "$commits_behind" -eq 0 ]]; then
    msg_success "You are up to date!"
    return 0
  else
    msg_info "Update available: $commits_behind commits behind."
    echo ""
    
    # Show recent commits
    msg_info "Recent changes:"
    git -C "$DOTFILES_ROOT" log HEAD..origin/main --oneline -10 2>/dev/null | sed 's/^/  /'
    echo ""
    
    msg_info "Run 'fc self-update' to update."
    return 1
  fi
}

do_update() {
  local force="$1"
  local no_deps="$2"
  local dry_run="$3"
  
  msg_info "Starting self-update..."
  echo ""
  
  # Tracks whether WE created a stash, so the restore below can be driven by
  # what actually happened rather than by re-inspecting the working tree.
  local stashed=false

  # Check for uncommitted changes
  if has_uncommitted_changes; then
    if [[ "$force" != "true" ]]; then
      msg_warning "You have uncommitted changes:"
      git -C "$DOTFILES_ROOT" status --short | sed 's/^/  /'
      echo ""
      msg_error "Commit or stash your changes first, or use --force to stash automatically."
      return 1
    else
      msg_info "Stashing uncommitted changes..."
      if [[ "$dry_run" != "true" ]]; then
        if git -C "$DOTFILES_ROOT" stash push -m "fc-self-update auto-stash $(date +%Y%m%d-%H%M%S)"; then
          stashed=true
        else
          msg_error "Could not stash your changes. Refusing to continue."
          return 1
        fi
      fi
    fi
  fi
  
  # Fetch latest
  msg_info "Fetching latest changes..."
  if [[ "$dry_run" != "true" ]]; then
    git -C "$DOTFILES_ROOT" fetch --all --prune --quiet
  fi
  
  # Check if update needed
  local commits_behind
  commits_behind=$(get_commits_behind)
  
  if [[ "$commits_behind" -eq 0 ]]; then
    msg_success "Already up to date!"
    restore_stash_if_any "$stashed"
    return 0
  fi

  # Get current version for migrations
  local old_version
  old_version=$(get_current_version)

  # The commit we are updating FROM. Recorded as a SHA rather than reusing
  # $old_version: the version strings are semver read from .version, and
  # `git diff 1.6.0..1.7.0` is not a valid revision range (the tags are v-
  # prefixed), so the Brewfile check below would silently match nothing.
  local old_sha
  old_sha=$(git -C "$DOTFILES_ROOT" rev-parse HEAD)

  # Show what will be updated
  msg_info "Changes to apply ($commits_behind commits):"
  git -C "$DOTFILES_ROOT" log HEAD..origin/main --oneline | sed 's/^/  /'
  echo ""
  
  if [[ "$dry_run" == "true" ]]; then
    msg_info "[DRY RUN] Would pull changes and run migrations."
    return 0
  fi
  
  # Verify the incoming commit's signature when a maintainer fingerprint is
  # pinned. Enforced only when CIRCUS_TRUSTED_SIGNING_FPR is set, because
  # requiring it unconditionally would break every repo that does not sign; but
  # when it IS set, an unsigned or wrongly-signed commit is refused outright
  # rather than downgraded to a prompt.
  if [[ -n "${CIRCUS_TRUSTED_SIGNING_FPR:-}" ]]; then
    if is_commit_signed "origin/main" "$DOTFILES_ROOT"; then
      msg_success "Signature verified against pinned key ${CIRCUS_TRUSTED_SIGNING_FPR:0:16}…"
    else
      msg_error "origin/main is not signed by the pinned key. Refusing to update."
      msg_info "Pinned: $CIRCUS_TRUSTED_SIGNING_FPR"
      msg_info "Inspect with: git -C $DOTFILES_ROOT log -1 --format='%G? %GF' origin/main"
      restore_stash_if_any "$stashed"
      return 1
    fi
  else
    msg_warning "No signing key pinned — the incoming commits are unverified."
    msg_info "Set CIRCUS_TRUSTED_SIGNING_FPR to require a signature from a specific key."
  fi

  # Confirm before executing remote code. The repository is symlinked into the
  # user's shell startup, so applying an update runs whatever arrived above.
  if ! ui_confirm "Apply these $commits_behind commit(s)?" "N"; then
    msg_info "Update cancelled. Nothing was changed."
    restore_stash_if_any "$stashed"
    return 0
  fi

  # Apply changes.
  #
  # `merge --ff-only` rather than `pull --rebase`: fast-forward can only advance
  # HEAD along the history that was just displayed and reviewed above. A rebase
  # would silently replay local commits onto a rewritten upstream, so a
  # force-push could change history the user already approved. --ff-only turns
  # that case into a visible failure instead.
  msg_info "Applying changes..."
  if ! git -C "$DOTFILES_ROOT" merge --ff-only origin/main; then
    msg_error "Fast-forward failed — upstream history diverged from your local branch."
    msg_info "This is worth looking at before proceeding: the remote may have been"
    msg_info "force-pushed, or you have local commits on top of main."
    msg_info "Inspect with: git -C $DOTFILES_ROOT log --oneline --graph HEAD origin/main"
    restore_stash_if_any "$stashed"
    return 1
  fi
  
  # Get new version
  local new_version
  new_version=$(get_current_version)
  
  # Run migrations
  if [[ -d "$MIGRATIONS_DIR" ]]; then
    msg_info "Checking for migrations..."
    run_migrations "$old_version" "$new_version"
  fi
  
  # Install new dependencies
  if [[ "$no_deps" != "true" ]]; then
    msg_info "Checking for new dependencies..."
    
    # Check if Brewfile changed, over the commit range we just fast-forwarded
    # across. This used to diff "$old_version..$new_version" — semver strings
    # from .version, which are not revisions (the tags are v-prefixed), so the
    # diff errored into /dev/null and new dependencies were never installed.
    if git -C "$DOTFILES_ROOT" diff "$old_sha" HEAD --name-only 2>/dev/null | grep -q "Brewfile"; then
      msg_info "Brewfile changed. Installing new dependencies..."
      if command -v brew &>/dev/null; then
        brew bundle --file="$DOTFILES_ROOT/Brewfile" --no-lock 2>/dev/null || true
      fi
    fi
  fi

  restore_stash_if_any "$stashed"

  echo ""
  msg_success "Update complete!"
  echo ""
  echo "  Previous version: $old_version"
  echo "  Current version:  $new_version"
  echo ""
  
  # Show CHANGELOG excerpt if available
  if [[ -f "$DOTFILES_ROOT/CHANGELOG.md" ]]; then
    msg_info "Recent changes (from CHANGELOG.md):"
    head -50 "$DOTFILES_ROOT/CHANGELOG.md" | grep -A 20 "^## \[" | head -25 | sed 's/^/  /'
  fi
}

run_migrations() {
  local old_version="$1"
  local new_version="$2"
  
  if [[ ! -d "$MIGRATIONS_DIR" ]]; then
    return 0
  fi
  
  # Find and run migrations between versions.
  #
  # Only files named vX_to_vY.sh are considered, and only when the upgrade path
  # actually covers that range. Previously this loop ran EVERY executable file
  # in migrations/ on every update, regardless of version — so any script that
  # landed in that directory executed unconditionally.
  local migration_count=0

  for migration in "$MIGRATIONS_DIR"/v*_to_v*.sh; do
    [[ -f "$migration" ]] || continue

    local migration_name from_ver to_ver
    migration_name=$(basename "$migration" .sh)
    from_ver=${migration_name%%_to_*}; from_ver=${from_ver#v}
    to_ver=${migration_name##*_to_};   to_ver=${to_ver#v}

    if ! version_in_range "$from_ver" "$to_ver" "$old_version" "$new_version"; then
      continue
    fi

    msg_info "  Running migration: $migration_name"
    if bash "$migration"; then
      migration_count=$((migration_count + 1))
    else
      msg_warning "  Migration $migration_name had issues (non-fatal)"
    fi
  done
  
  if [[ $migration_count -gt 0 ]]; then
    msg_success "Ran $migration_count migrations."
  fi
}

# --- Main -------------------------------------------------------------------
main() {
  local check_only=false
  local force=false
  local no_deps=false
  local dry_run=false
  
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help)
        usage
        ;;
      --check)
        check_only=true
        shift
        ;;
      --force)
        force=true
        shift
        ;;
      --no-deps)
        no_deps=true
        shift
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      *)
        die "Unknown option '$1'. Run 'fc self-update --help' for usage."
        ;;
    esac
  done
  
  # Ensure we're in a git repo
  if ! git -C "$DOTFILES_ROOT" rev-parse --git-dir &>/dev/null; then
    die "Not a git repository. Cannot self-update."
  fi
  
  if [[ "$check_only" == "true" ]]; then
    do_check
  else
    do_update "$force" "$no_deps" "$dry_run"
  fi
}

main "$@"
